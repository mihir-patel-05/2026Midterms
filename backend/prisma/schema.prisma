// Prisma schema for 2026 Midterm Elections Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Candidates running for federal office
model Candidate {
  id              String  @id @default(uuid())
  candidateId     String  @unique @map("candidate_id") // FEC candidate ID
  name            String
  party           String?
  office          String // HOUSE, SENATE
  district        String? // For House races
  state           String // Two-letter state code
  incumbentStatus String? @map("incumbent_status")
  activeThrough   Int?    @map("active_through")
  cycles          Int[] // Election cycles
  electionYears   Int[]   @map("election_years")
  candidateStatus String? @map("candidate_status")

  // Detail fields for candidate profile
  biography         String? @db.Text
  currentOfficeHeld String? @map("current_office_held")
  campaignWebsite   String? @map("campaign_website")
  socialMedia       Json?   @map("social_media") // {twitter, facebook, instagram, etc.}

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  committees            Committee[]
  candidateElections    CandidateElection[]
  ideologyScores        IdeologyScore[]
  financials            CandidateFinancial[]
  normalizedCandidacies Candidacy[]          @relation("LegacyCandidateCandidacies")

  @@index([candidateId])
  @@index([name])
  @@index([state])
  @@index([party])
  @@index([office])
  @@map("candidates")
}

// Candidate-level financial totals (aggregated from FEC)
model CandidateFinancial {
  id                    String @id @default(uuid())
  candidateId           String @map("candidate_id")
  cycle                 Int
  candidateElectionYear Int?   @map("candidate_election_year")

  // Receipt totals
  receipts                          Decimal @default(0) @db.Decimal(15, 2)
  contributions                     Decimal @default(0) @db.Decimal(15, 2)
  individualContributions           Decimal @default(0) @map("individual_contributions") @db.Decimal(15, 2)
  individualItemizedContributions   Decimal @default(0) @map("individual_itemized_contributions") @db.Decimal(15, 2)
  individualUnitemizedContributions Decimal @default(0) @map("individual_unitemized_contributions") @db.Decimal(15, 2)
  pacContributions                  Decimal @default(0) @map("pac_contributions") @db.Decimal(15, 2)
  partyContributions                Decimal @default(0) @map("party_contributions") @db.Decimal(15, 2)
  candidateContribution             Decimal @default(0) @map("candidate_contribution") @db.Decimal(15, 2)
  otherReceipts                     Decimal @default(0) @map("other_receipts") @db.Decimal(15, 2)
  transfersFromAffiliatedCommittee  Decimal @default(0) @map("transfers_from_affiliated_committee") @db.Decimal(15, 2)
  loansReceived                     Decimal @default(0) @map("loans_received") @db.Decimal(15, 2)
  loansReceivedFromCandidate        Decimal @default(0) @map("loans_received_from_candidate") @db.Decimal(15, 2)
  otherLoansReceived                Decimal @default(0) @map("other_loans_received") @db.Decimal(15, 2)
  federalFunds                      Decimal @default(0) @map("federal_funds") @db.Decimal(15, 2)

  // Disbursement totals
  disbursements                       Decimal @default(0) @db.Decimal(15, 2)
  operatingExpenditures               Decimal @default(0) @map("operating_expenditures") @db.Decimal(15, 2)
  transfersToOtherAuthorizedCommittee Decimal @default(0) @map("transfers_to_other_authorized_committee") @db.Decimal(15, 2)
  fundraisingDisbursements            Decimal @default(0) @map("fundraising_disbursements") @db.Decimal(15, 2)
  exemptLegalAccountingDisbursement   Decimal @default(0) @map("exempt_legal_accounting_disbursement") @db.Decimal(15, 2)
  loanRepaymentsMade                  Decimal @default(0) @map("loan_repayments_made") @db.Decimal(15, 2)
  repaymentsLoansMadeByCandidate      Decimal @default(0) @map("repayments_loans_made_by_candidate") @db.Decimal(15, 2)
  repaymentsOtherLoans                Decimal @default(0) @map("repayments_other_loans") @db.Decimal(15, 2)
  otherDisbursements                  Decimal @default(0) @map("other_disbursements") @db.Decimal(15, 2)

  // Refunds
  contributionRefunds                          Decimal @default(0) @map("contribution_refunds") @db.Decimal(15, 2)
  refundedIndividualContributions              Decimal @default(0) @map("refunded_individual_contributions") @db.Decimal(15, 2)
  refundedOtherPoliticalCommitteeContributions Decimal @default(0) @map("refunded_other_political_committee_contributions") @db.Decimal(15, 2)
  refundedPoliticalPartyCommitteeContributions Decimal @default(0) @map("refunded_political_party_committee_contributions") @db.Decimal(15, 2)

  // Offsets
  offsetsToOperatingExpenditures      Decimal @default(0) @map("offsets_to_operating_expenditures") @db.Decimal(15, 2)
  totalOffsetsToOperatingExpenditures Decimal @default(0) @map("total_offsets_to_operating_expenditures") @db.Decimal(15, 2)
  offsetsToFundraisingExpenditures    Decimal @default(0) @map("offsets_to_fundraising_expenditures") @db.Decimal(15, 2)
  offsetsToLegalAccounting            Decimal @default(0) @map("offsets_to_legal_accounting") @db.Decimal(15, 2)

  // Net calculations
  netContributions         Decimal @default(0) @map("net_contributions") @db.Decimal(15, 2)
  netOperatingExpenditures Decimal @default(0) @map("net_operating_expenditures") @db.Decimal(15, 2)

  // End of period data
  cashOnHand           Decimal @default(0) @map("cash_on_hand") @db.Decimal(15, 2)
  debtsOwed            Decimal @default(0) @map("debts_owed") @db.Decimal(15, 2)
  debtsOwedToCommittee Decimal @default(0) @map("debts_owed_to_committee") @db.Decimal(15, 2)

  // Coverage dates and metadata
  coverageStartDate        DateTime? @map("coverage_start_date")
  coverageEndDate          DateTime? @map("coverage_end_date")
  transactionCoverageDate  DateTime? @map("transaction_coverage_date")
  lastReportYear           Int?      @map("last_report_year")
  lastReportTypeFull       String?   @map("last_report_type_full")
  lastBeginningImageNumber String?   @map("last_beginning_image_number")
  electionFull             Boolean?  @map("election_full")
  // Set only by the per-candidate totals sync. Rows written by the bulk sync have
  // headline totals but no source breakdown (party, self-funded, unitemized).
  detailedSyncedAt         DateTime? @map("detailed_synced_at")

  lastUpdated DateTime @default(now()) @map("last_updated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [candidateId])

  @@unique([candidateId, cycle])
  @@index([candidateId])
  @@index([cycle])
  @@map("candidate_financials")
}

// Campaign committees
model Committee {
  id                           String    @id @default(uuid())
  committeeId                  String    @unique @map("committee_id") // FEC committee ID
  name                         String
  committeeType                String?   @map("committee_type")
  designation                  String?
  candidateId                  String?   @map("candidate_id")
  party                        String?
  state                        String?
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  itemizedLastSyncedAt         DateTime? @map("itemized_last_synced_at")
  itemizedLastAttemptedAt      DateTime? @map("itemized_last_attempted_at")
  itemizedSyncError            String?   @map("itemized_sync_error") @db.Text
  itemizedSyncCycle            Int?      @map("itemized_sync_cycle")
  receiptSyncCursor            Json?     @map("receipt_sync_cursor")
  disbursementSyncCursor       Json?     @map("disbursement_sync_cursor")
  receiptBackfillComplete      Boolean   @default(false) @map("receipt_backfill_complete")
  disbursementBackfillComplete Boolean   @default(false) @map("disbursement_backfill_complete")

  // Relations
  candidate          Candidate?         @relation(fields: [candidateId], references: [candidateId])
  financialSummaries FinancialSummary[]
  receipts           Receipt[]
  disbursements      Disbursement[]

  @@index([committeeId])
  @@index([candidateId])
  @@index([state])
  @@index([itemizedLastAttemptedAt])
  @@map("committees")
}

// Elections (primary and general)
model Election {
  id           String   @id @default(uuid())
  state        String // Two-letter state code
  district     String? // For House races
  officeType   String   @map("office_type") // HOUSE, SENATE
  electionDate DateTime @map("election_date") @db.Date
  electionType String   @map("election_type") // PRIMARY, GENERAL
  cycle        Int // Election year
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  candidateElections CandidateElection[]
  normalizedContest  Contest?            @relation("LegacyElectionContest")

  @@index([state])
  @@index([electionDate])
  @@index([cycle])
  @@index([officeType])
  @@map("elections")
}

// Many-to-many relationship between candidates and elections
model CandidateElection {
  id             String   @id @default(uuid())
  candidateId    String   @map("candidate_id")
  electionId     String   @map("election_id")
  isIncumbent    Boolean  @default(false) @map("is_incumbent")
  result         String? // WON, LOST, PENDING
  votePercentage Float?   @map("vote_percentage")
  ballotStatus   String   @default("UNCONFIRMED") @map("ballot_status") // CONFIRMED | UNCONFIRMED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  candidate           Candidate  @relation(fields: [candidateId], references: [candidateId])
  election            Election   @relation(fields: [electionId], references: [id])
  normalizedCandidacy Candidacy? @relation("LegacyCandidateElectionCandidacy")

  @@unique([candidateId, electionId])
  @@index([candidateId])
  @@index([electionId])
  @@map("candidate_elections")
}

// Aggregated financial summaries
model FinancialSummary {
  id                 String    @id @default(uuid())
  committeeId        String    @map("committee_id")
  cycle              Int
  totalReceipts      Decimal   @default(0) @map("total_receipts") @db.Decimal(15, 2)
  totalDisbursements Decimal   @default(0) @map("total_disbursements") @db.Decimal(15, 2)
  cashOnHand         Decimal   @default(0) @map("cash_on_hand") @db.Decimal(15, 2)
  debtOwed           Decimal   @default(0) @map("debt_owed") @db.Decimal(15, 2)
  coverageEndDate    DateTime? @map("coverage_end_date")
  lastUpdated        DateTime  @default(now()) @map("last_updated")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  committee Committee @relation(fields: [committeeId], references: [committeeId])

  @@unique([committeeId, cycle])
  @@index([committeeId])
  @@index([cycle])
  @@map("financial_summaries")
}

// Itemized receipts (Schedule A)
model Receipt {
  id                        String    @id @default(uuid())
  sourceId                  String?   @unique @map("source_id") // FEC sub_id or deterministic fallback
  transactionId             String?   @map("transaction_id")
  fileNumber                Int?      @map("file_number")
  amendmentIndicator        String?   @map("amendment_indicator")
  cycle                     Int?
  memoedSubtotal            Boolean   @default(false) @map("memoed_subtotal")
  committeeId               String    @map("committee_id")
  contributorCommitteeId    String?   @map("contributor_committee_id")
  contributorName           String?   @map("contributor_name")
  contributorState          String?   @map("contributor_state")
  contributorCity           String?   @map("contributor_city")
  contributorEmployer       String?   @map("contributor_employer")
  contributorOccupation     String?   @map("contributor_occupation")
  contributionReceiptAmount Decimal   @map("contribution_receipt_amount") @db.Decimal(15, 2)
  contributionReceiptDate   DateTime? @map("contribution_receipt_date")
  receiptType               String?   @map("receipt_type")
  imageNumber               String?   @map("image_number")
  createdAt                 DateTime  @default(now()) @map("created_at")

  // Relations
  committee Committee @relation(fields: [committeeId], references: [committeeId])

  @@index([committeeId])
  @@index([committeeId, cycle])
  @@index([committeeId, transactionId])
  @@index([contributorCommitteeId])
  @@index([contributorName])
  @@index([contributionReceiptDate])
  @@index([contributionReceiptAmount])
  @@map("receipts")
}

// Itemized disbursements (Schedule B)
model Disbursement {
  id                      String    @id @default(uuid())
  sourceId                String?   @unique @map("source_id") // FEC sub_id or deterministic fallback
  transactionId           String?   @map("transaction_id")
  fileNumber              Int?      @map("file_number")
  amendmentIndicator      String?   @map("amendment_indicator")
  cycle                   Int?
  memoedSubtotal          Boolean   @default(false) @map("memoed_subtotal")
  committeeId             String    @map("committee_id")
  recipientName           String?   @map("recipient_name")
  disbursementType        String?   @map("disbursement_type")
  disbursementAmount      Decimal   @map("disbursement_amount") @db.Decimal(15, 2)
  disbursementDate        DateTime? @map("disbursement_date")
  disbursementDescription String?   @map("disbursement_description")
  imageNumber             String?   @map("image_number")
  createdAt               DateTime  @default(now()) @map("created_at")

  // Relations
  committee Committee @relation(fields: [committeeId], references: [committeeId])

  @@index([committeeId])
  @@index([committeeId, cycle])
  @@index([committeeId, transactionId])
  @@index([disbursementDate])
  @@index([disbursementAmount])
  @@map("disbursements")
}

// Ideology scores (GovTrack-style)
model IdeologyScore {
  id               String   @id @default(uuid())
  candidateId      String   @map("candidate_id")
  congressSession  Int      @map("congress_session")
  ideologyScore    Float?   @map("ideology_score") // Left-right spectrum score
  leadershipScore  Float?   @map("leadership_score") // Leadership effectiveness score
  billsSponsored   Int      @default(0) @map("bills_sponsored")
  billsCosponsored Int      @default(0) @map("bills_cosponsored")
  calculatedAt     DateTime @default(now()) @map("calculated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [candidateId])

  @@unique([candidateId, congressSession])
  @@index([candidateId])
  @@index([congressSession])
  @@map("ideology_scores")
}

// Sync logs for tracking data synchronization jobs
model SyncLog {
  id               String    @id @default(uuid())
  syncType         String    @map("sync_type") // "candidates", "finance", "full", "committees"
  status           String // "started", "running", "completed", "failed"
  recordsProcessed Int       @default(0) @map("records_processed")
  recordsErrors    Int       @default(0) @map("records_errors")
  recordsSkipped   Int       @default(0) @map("records_skipped")
  errorMessage     String?   @map("error_message") @db.Text
  metadata         Json? // Additional sync details (states, cycles, etc.)
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")
  duration         Int? // Duration in milliseconds
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("sync_logs")
}

// Cross-process lease used to prevent overlapping scheduled/manual sync jobs.
model SyncLease {
  name      String   @id
  token     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("sync_leases")
}

// Admin users for dashboard authentication
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  email        String?   @unique
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@index([username])
  @@index([email])
  @@map("admin_users")
}

// Durable admin sessions. Only a SHA-256 hash of the bearer token is stored.
model AdminSession {
  id          String   @id @default(uuid())
  tokenHash   String   @unique @map("token_hash")
  adminUserId String   @map("admin_user_id")
  expiresAt   DateTime @map("expires_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// Counties (US Census gazetteer)
model County {
  fipsCode  String   @id @map("fips_code") // 5-digit FIPS (state+county)
  state     String // Two-letter state code
  name      String // County name
  districts String[] // CD numbers intersecting this county
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  results CountyResult[]

  @@index([state])
  @@map("counties")
}

// Historical county-level race results (MIT Election Lab)
model CountyResult {
  id            String   @id @default(uuid())
  countyFips    String   @map("county_fips")
  cycle         Int
  state         String
  officeType    String   @map("office_type") // HOUSE, SENATE
  district      String   @default("") // CD number for House, "" for Senate
  party         String // DEMOCRAT, REPUBLICAN, OTHER
  candidateName String   @map("candidate_name")
  votes         Int
  votePct       Float    @map("vote_pct")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  county County @relation(fields: [countyFips], references: [fipsCode])

  @@unique([countyFips, cycle, officeType, district, candidateName])
  @@index([cycle, state, officeType])
  @@index([state, district, cycle])
  @@map("county_results")
}

// Researcher users (separate role from admin)
model ResearcherUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  savedSimulations SavedSimulation[]

  @@index([email])
  @@map("researcher_users")
}

// Saved simulation scenarios (persistence scaffold)
model SavedSimulation {
  id           String   @id @default(uuid())
  researcherId String   @map("researcher_id")
  name         String
  params       Json // { baselineCycle, swings: {...} }
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  researcher ResearcherUser @relation(fields: [researcherId], references: [id], onDelete: Cascade)

  @@index([researcherId])
  @@map("saved_simulations")
}

// Deadlines for voter registration and elections
model Deadline {
  id          String   @id @default(uuid())
  title       String // e.g., "Primary Registration Deadline"
  date        DateTime @db.Date
  type        String // "registration" | "election" | "other"
  states      String[] // e.g., ["CA", "TX"] or ["ALL"]
  description String?  @db.Text
  urgent      Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([isActive])
  @@map("deadlines")
}

// Provider-neutral election/result models. The legacy Candidate, Election,
// CandidateElection, County, and CountyResult models remain unchanged and can
// be linked during a reviewed backfill.

enum ElectionEventType {
  GENERAL
  PRIMARY
  RUNOFF
  SPECIAL
  OTHER
}

enum ElectionEventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum ContestStatus {
  SCHEDULED
  OPEN
  UNCONTESTED
  REPORTING
  COMPLETE
  CANCELLED
}

enum BallotStatus {
  UNCONFIRMED
  FEC_FILED
  BALLOT_CONFIRMED
  WITHDRAWN
  DISQUALIFIED
  WRITE_IN
}

enum DataSourceType {
  OFFICIAL_FEDERAL
  OFFICIAL_STATE
  OFFICIAL_LOCAL
  LICENSED_PROVIDER
  MOCK_FIXTURE
  OTHER
}

enum SourceHealthStatus {
  CURRENT
  STALE
  DEGRADED
  UNAVAILABLE
  NOT_CONFIGURED
}

enum IngestionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum IngestionErrorSeverity {
  WARNING
  ERROR
  FATAL
}

enum RawArtifactStatus {
  FETCHED
  VALIDATED
  REJECTED
}

enum GeographyUnitType {
  NATION
  STATE
  CONGRESSIONAL_DISTRICT
  COUNTY
  PRECINCT
  SPLIT_PRECINCT
  MUNICIPALITY
  OTHER
}

enum GeographyRelationshipType {
  CONTAINS
  INTERSECTS
  EQUIVALENT_TO
}

enum ReportingUnitType {
  NATION
  STATE
  DISTRICT
  COUNTY
  PRECINCT
  SPLIT_PRECINCT
  BALLOT_BATCH
  OTHER
}

enum SnapshotPublicationStatus {
  STAGED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum ReportingStatus {
  NOT_STARTED
  PARTIAL
  COMPLETE
  DELAYED
  SUSPENDED
  UNAVAILABLE
}

enum CertificationStatus {
  UNOFFICIAL
  CANVASSING
  CERTIFIED
  RECOUNT
  CONTESTED
}

enum CertificationEventType {
  UNOFFICIAL_RESULTS_PUBLISHED
  CANVASS_STARTED
  AUDIT_STARTED
  CERTIFIED
  RECOUNT_STARTED
  RECOUNT_COMPLETED
  CONTESTED
  CORRECTED
}

model DataSource {
  id                     String             @id @default(uuid())
  key                    String             @unique
  name                   String
  type                   DataSourceType
  authority              String?
  homepageUrl            String?            @map("homepage_url")
  attributionText        String             @map("attribution_text")
  licenseName            String?            @map("license_name")
  licenseUrl             String?            @map("license_url")
  coverageDescription    String?            @map("coverage_description") @db.Text
  expectedCadenceSeconds Int?               @map("expected_cadence_seconds")
  healthStatus           SourceHealthStatus @default(NOT_CONFIGURED) @map("health_status")
  lastCheckedAt          DateTime?          @map("last_checked_at")
  lastSuccessfulAt       DateTime?          @map("last_successful_at")
  isEnabled              Boolean            @default(false) @map("is_enabled")
  isMock                 Boolean            @default(false) @map("is_mock")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  electionEvents      ElectionEvent[]
  contests            Contest[]
  candidacies         Candidacy[]
  reportingUnits      ReportingUnit[]
  ingestionRuns       IngestionRun[]
  rawArtifacts        RawArtifact[]
  resultSnapshots     ResultSnapshot[]
  certificationEvents CertificationEvent[]
  marketSnapshots     MarketSnapshot[]
  indicatorSeries     IndicatorSeries[]
  districtProfiles    DistrictProfile[]
  areaDemographics    AreaDemographics[]

  @@index([type])
  @@index([healthStatus])
  @@index([isEnabled, isMock])
  @@map("data_sources")
}

model ElectionEvent {
  id               String              @id @default(uuid())
  name             String
  electionDate     DateTime            @map("election_date") @db.Date
  type             ElectionEventType
  status           ElectionEventStatus @default(SCHEDULED)
  cycle            Int
  stateCode        String?             @map("state_code")
  sourceId         String?             @map("source_id")
  sourceElectionId String?             @map("source_election_id")
  sourceUrl        String?             @map("source_url")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  source   DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  contests Contest[]

  @@unique([sourceId, sourceElectionId])
  @@index([electionDate])
  @@index([cycle, stateCode])
  @@index([status])
  @@map("election_events")
}

model Contest {
  id                 String        @id @default(uuid())
  electionEventId    String        @map("election_event_id")
  sourceId           String?       @map("source_id")
  sourceContestId    String?       @map("source_contest_id")
  legacyElectionId   String?       @unique @map("legacy_election_id")
  electionDistrictId String?       @map("election_district_id")
  currentSnapshotId  String?       @unique @map("current_snapshot_id")
  name               String
  office             String
  officeLevel        String?       @map("office_level")
  stateCode          String?       @map("state_code")
  districtCode       String?       @map("district_code")
  status             ContestStatus @default(SCHEDULED)
  voteFor            Int           @default(1) @map("vote_for")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  electionEvent       ElectionEvent        @relation(fields: [electionEventId], references: [id], onDelete: Cascade)
  source              DataSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  legacyElection      Election?            @relation("LegacyElectionContest", fields: [legacyElectionId], references: [id], onDelete: SetNull)
  electionDistrict    GeographyUnit?       @relation(fields: [electionDistrictId], references: [id], onDelete: SetNull)
  currentSnapshot     ResultSnapshot?      @relation("CurrentContestSnapshot", fields: [currentSnapshotId], references: [id], onDelete: SetNull)
  candidacies         Candidacy[]
  snapshots           ResultSnapshot[]     @relation("ContestResultSnapshots")
  certificationEvents CertificationEvent[]
  ingestionErrors     IngestionError[]
  marketSnapshots     MarketSnapshot[]

  @@unique([sourceId, sourceContestId])
  @@index([electionEventId, office, districtCode])
  @@index([stateCode, office])
  @@index([status])
  @@map("contests")
}

model Person {
  id             String   @id @default(uuid())
  displayName    String   @map("display_name")
  normalizedName String   @map("normalized_name")
  firstName      String?  @map("first_name")
  middleName     String?  @map("middle_name")
  lastName       String?  @map("last_name")
  suffix         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  candidacies Candidacy[]

  @@index([normalizedName])
  @@map("people")
}

model Party {
  id           String   @id @default(uuid())
  name         String
  abbreviation String?
  sourceCode   String?  @map("source_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  candidacies Candidacy[]

  @@unique([name, sourceCode])
  @@index([abbreviation])
  @@map("parties")
}

model Candidacy {
  id                        String       @id @default(uuid())
  personId                  String       @map("person_id")
  contestId                 String       @map("contest_id")
  partyId                   String?      @map("party_id")
  sourceId                  String?      @map("source_id")
  sourceCandidateId         String?      @map("source_candidate_id")
  fecCandidateId            String?      @map("fec_candidate_id")
  legacyCandidateId         String?      @map("legacy_candidate_id")
  legacyCandidateElectionId String?      @unique @map("legacy_candidate_election_id")
  ballotName                String?      @map("ballot_name")
  ballotOrder               Int?         @map("ballot_order")
  ballotStatus              BallotStatus @default(UNCONFIRMED) @map("ballot_status")
  isIncumbent               Boolean      @default(false) @map("is_incumbent")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  person                  Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  contest                 Contest            @relation(fields: [contestId], references: [id], onDelete: Cascade)
  party                   Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  source                  DataSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  legacyCandidate         Candidate?         @relation("LegacyCandidateCandidacies", fields: [legacyCandidateId], references: [id], onDelete: SetNull)
  legacyCandidateElection CandidateElection? @relation("LegacyCandidateElectionCandidacy", fields: [legacyCandidateElectionId], references: [id], onDelete: SetNull)
  votes                   CandidateVote[]

  @@unique([contestId, personId])
  @@unique([sourceId, sourceCandidateId, contestId])
  @@index([contestId, ballotOrder])
  @@index([fecCandidateId])
  @@index([legacyCandidateId])
  @@index([ballotStatus])
  @@map("candidacies")
}

model GeographyVersion {
  id          String    @id @default(uuid())
  name        String    @unique
  vintage     String
  congress    Int?
  sourceUrl   String    @map("source_url")
  sha256      String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  units GeographyUnit[]

  @@unique([vintage, congress, sha256])
  @@map("geography_versions")
}

model GeographyUnit {
  id           String            @id @default(uuid())
  versionId    String            @map("version_id")
  type         GeographyUnitType
  geoid        String
  name         String
  stateCode    String?           @map("state_code")
  districtCode String?           @map("district_code")
  countyFips   String?           @map("county_fips")
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  version          GeographyVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  parentRelations  GeographyRelation[] @relation("GeographyHierarchyParent")
  childRelations   GeographyRelation[] @relation("GeographyHierarchyChild")
  reportingUnits   ReportingUnit[]
  contests         Contest[]
  districtProfiles DistrictProfile[]

  @@unique([versionId, type, geoid])
  @@index([versionId, stateCode, type])
  @@index([countyFips])
  @@map("geography_units")
}

model GeographyRelation {
  parentId          String                    @map("parent_id")
  childId           String                    @map("child_id")
  relationshipType  GeographyRelationshipType @map("relationship_type")
  overlapPercentage Decimal?                  @map("overlap_percentage") @db.Decimal(7, 4)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  parent GeographyUnit @relation("GeographyHierarchyParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  GeographyUnit @relation("GeographyHierarchyChild", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId, relationshipType])
  @@index([childId, relationshipType])
  @@map("geography_relations")
}

model ReportingUnit {
  id              String            @id @default(uuid())
  sourceId        String            @map("source_id")
  geographyUnitId String?           @map("geography_unit_id")
  parentId        String?           @map("parent_id")
  sourceUnitId    String            @map("source_unit_id")
  name            String
  type            ReportingUnitType
  isDistricted    Boolean           @default(false) @map("is_districted")
  isMailOnly      Boolean           @default(false) @map("is_mail_only")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  source         DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  geographyUnit  GeographyUnit?  @relation(fields: [geographyUnitId], references: [id], onDelete: SetNull)
  parent         ReportingUnit?  @relation("ReportingUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       ReportingUnit[] @relation("ReportingUnitHierarchy")
  candidateVotes CandidateVote[]
  contestMetrics ContestMetric[]

  @@unique([sourceId, sourceUnitId])
  @@index([geographyUnitId])
  @@index([parentId])
  @@index([type])
  @@map("reporting_units")
}

model IngestionRun {
  id              String             @id @default(uuid())
  sourceId        String             @map("source_id")
  status          IngestionRunStatus @default(QUEUED)
  parserVersion   String             @map("parser_version")
  startedAt       DateTime?          @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  recordsFetched  Int                @default(0) @map("records_fetched")
  recordsAccepted Int                @default(0) @map("records_accepted")
  recordsRejected Int                @default(0) @map("records_rejected")
  errorSummary    String?            @map("error_summary") @db.Text
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  source              DataSource           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  artifacts           RawArtifact[]
  errors              IngestionError[]
  resultSnapshots     ResultSnapshot[]
  certificationEvents CertificationEvent[]
  areaDemographics    AreaDemographics[]
  newsStories         NewsStory[]

  @@index([sourceId, startedAt])
  @@index([status, createdAt])
  @@map("ingestion_runs")
}

model RawArtifact {
  id              String            @id @default(uuid())
  sourceId        String            @map("source_id")
  ingestionRunId  String            @map("ingestion_run_id")
  status          RawArtifactStatus @default(FETCHED)
  storageKey      String            @map("storage_key")
  contentSha256   String            @map("content_sha256")
  contentType     String?           @map("content_type")
  payloadByteSize BigInt?           @map("payload_byte_size")
  sourceUrl       String?           @map("source_url")
  sourceUpdatedAt DateTime?         @map("source_updated_at")
  fetchedAt       DateTime          @default(now()) @map("fetched_at")
  httpStatus      Int?              @map("http_status")
  etag            String?
  lastModified    String?           @map("last_modified")
  isMock          Boolean           @default(false) @map("is_mock")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  source       DataSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun     @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  snapshots    ResultSnapshot[]
  errors       IngestionError[]

  @@unique([sourceId, contentSha256])
  @@index([ingestionRunId])
  @@index([status, fetchedAt])
  @@map("raw_artifacts")
}

model IngestionError {
  id             String                 @id @default(uuid())
  ingestionRunId String                 @map("ingestion_run_id")
  rawArtifactId  String?                @map("raw_artifact_id")
  contestId      String?                @map("contest_id")
  severity       IngestionErrorSeverity @default(ERROR)
  code           String
  message        String                 @db.Text
  recordKey      String?                @map("record_key")
  details        Json?
  occurredAt     DateTime               @default(now()) @map("occurred_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  rawArtifact  RawArtifact? @relation(fields: [rawArtifactId], references: [id], onDelete: SetNull)
  contest      Contest?     @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([ingestionRunId, severity])
  @@index([rawArtifactId])
  @@index([contestId])
  @@map("ingestion_errors")
}

model ResultSnapshot {
  id                String                    @id @default(uuid())
  contestId         String                    @map("contest_id")
  sourceId          String                    @map("source_id")
  ingestionRunId    String?                   @map("ingestion_run_id")
  rawArtifactId     String?                   @map("raw_artifact_id")
  sourceSnapshotId  String?                   @map("source_snapshot_id")
  payloadSha256     String                    @map("payload_sha256")
  publicationStatus SnapshotPublicationStatus @default(STAGED) @map("publication_status")
  reportingStatus   ReportingStatus           @default(NOT_STARTED) @map("reporting_status")
  certification     CertificationStatus       @default(UNOFFICIAL)
  sourceUpdatedAt   DateTime?                 @map("source_updated_at")
  receivedAt        DateTime                  @default(now()) @map("received_at")
  publishedAt       DateTime?                 @map("published_at")
  isPartial         Boolean                   @default(false) @map("is_partial")
  isMock            Boolean                   @default(false) @map("is_mock")
  notes             String?                   @db.Text
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  contest           Contest         @relation("ContestResultSnapshots", fields: [contestId], references: [id], onDelete: Cascade)
  source            DataSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun      IngestionRun?   @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  rawArtifact       RawArtifact?    @relation(fields: [rawArtifactId], references: [id], onDelete: SetNull)
  currentForContest Contest?        @relation("CurrentContestSnapshot")
  candidateVotes    CandidateVote[]
  contestMetrics    ContestMetric[]

  @@unique([contestId, sourceId, payloadSha256])
  @@index([contestId, publishedAt])
  @@index([sourceId, sourceUpdatedAt])
  @@index([publicationStatus, reportingStatus])
  @@map("result_snapshots")
}

model CandidateVote {
  id                   String   @id @default(uuid())
  snapshotId           String   @map("snapshot_id")
  candidacyId          String   @map("candidacy_id")
  reportingUnitId      String   @map("reporting_unit_id")
  voteType             String   @default("TOTAL") @map("vote_type")
  votes                BigInt
  sourceVotePercentage Decimal? @map("source_vote_percentage") @db.Decimal(7, 4)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  snapshot      ResultSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  candidacy     Candidacy      @relation(fields: [candidacyId], references: [id], onDelete: Restrict)
  reportingUnit ReportingUnit  @relation(fields: [reportingUnitId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, candidacyId, reportingUnitId, voteType])
  @@index([snapshotId, reportingUnitId])
  @@index([candidacyId, snapshotId])
  @@map("candidate_votes")
}

model ContestMetric {
  id                      String   @id @default(uuid())
  snapshotId              String   @map("snapshot_id")
  reportingUnitId         String   @map("reporting_unit_id")
  ballotsCast             BigInt?  @map("ballots_cast")
  votesCounted            BigInt?  @map("votes_counted")
  registeredVoters        BigInt?  @map("registered_voters")
  reportingUnitsTotal     Int?     @map("reporting_units_total")
  reportingUnitsReporting Int?     @map("reporting_units_reporting")
  precinctsTotal          Int?     @map("precincts_total")
  precinctsReporting      Int?     @map("precincts_reporting")
  reportingPercentage     Decimal? @map("reporting_percentage") @db.Decimal(7, 4)
  isComplete              Boolean? @map("is_complete")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  snapshot      ResultSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reportingUnit ReportingUnit  @relation(fields: [reportingUnitId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, reportingUnitId])
  @@index([reportingUnitId])
  @@map("contest_metrics")
}

model CertificationEvent {
  id             String                 @id @default(uuid())
  contestId      String                 @map("contest_id")
  sourceId       String                 @map("source_id")
  ingestionRunId String?                @map("ingestion_run_id")
  type           CertificationEventType
  certification  CertificationStatus
  effectiveAt    DateTime               @map("effective_at")
  sourceUrl      String                 @map("source_url")
  notes          String?                @db.Text
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  contest      Contest       @relation(fields: [contestId], references: [id], onDelete: Cascade)
  source       DataSource    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@index([contestId, effectiveAt])
  @@index([sourceId])
  @@map("certification_events")
}

// Intel v2 batch 1: market history, economic indicators, district profiles,
// and the agent run log. See docs/DATABASE_SCHEMA.md#intel-v2-proposed-schema.

enum MarketProvider {
  KALSHI
  POLYMARKET // Unused since Oct 10 (Kalshi only); kept so migrations stay additive.
}

enum MarketScope {
  NATIONAL_HOUSE
  NATIONAL_SENATE
  STATE_SENATE
  HOUSE_DISTRICT
}

enum MarketPriceType {
  MIDPOINT
  LAST_TRADE
  OUTCOME_PRICE
}

enum IndicatorFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum AgentKind {
  NEWS_TRIAGE
  DISTRICT_ISSUES
  WHY_IT_MOVED
  SIGNAL_DIVERGENCE
  DAILY_BRIEF
  CANDIDATE_POSITIONS
  DATA_QA
  ASK_THE_RACE
  ELECTION_NIGHT
  TOP_STORIES
}

// Hourly prediction-market price per provider market outcome. Prices are
// fractions in [0, 1] (enforced by CHECK constraints in the migration) and are
// market prices, not forecasts.
model MarketSnapshot {
  id             String          @id @default(uuid())
  sourceId       String          @map("source_id")
  provider       MarketProvider
  scope          MarketScope
  sourceEventId  String          @map("source_event_id") // Kalshi event ticker
  sourceMarketId String          @map("source_market_id") // Kalshi market ticker
  outcome        String
  contestId      String?         @map("contest_id") // Null for national control markets
  stateCode      String?         @map("state_code")
  districtCode   String?         @map("district_code")
  priceType      MarketPriceType @map("price_type")
  price          Decimal         @db.Decimal(5, 4)
  yesBid         Decimal?        @map("yes_bid") @db.Decimal(5, 4)
  yesAsk         Decimal?        @map("yes_ask") @db.Decimal(5, 4)
  volume         Decimal?        @db.Decimal(18, 2)
  liquidity      Decimal?        @db.Decimal(18, 2)
  sourceUrl      String?         @map("source_url")
  capturedHour   DateTime        @map("captured_hour") // Truncated to the hour
  fetchedAt      DateTime        @map("fetched_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  source  DataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  contest Contest?   @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@unique([provider, sourceMarketId, capturedHour])
  @@index([contestId, capturedHour])
  @@index([scope, stateCode, districtCode, capturedHour])
  @@index([provider, capturedHour])
  @@map("market_snapshots")
}

// Economic indicator catalog (e.g. FRED DGS10, T10Y2Y, VIXCLS).
model IndicatorSeries {
  id          String             @id @default(uuid())
  key         String             @unique
  name        String
  unit        String
  frequency   IndicatorFrequency
  description String?            @db.Text
  sourceId    String             @map("source_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  source       DataSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  observations IndicatorObservation[]

  @@index([sourceId])
  @@map("indicator_series")
}

model IndicatorObservation {
  id         String   @id @default(uuid())
  seriesId   String   @map("series_id")
  observedAt DateTime @map("observed_at") @db.Date
  value      Decimal  @db.Decimal(18, 6)
  fetchedAt  DateTime @map("fetched_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  series IndicatorSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, observedAt])
  @@map("indicator_observations")
}

// District fundamentals and ACS demographics per census vintage.
// geographyUnitId stays null until the geography vintage is chosen.
model DistrictProfile {
  id                    String   @id @default(uuid())
  stateCode             String   @map("state_code")
  districtCode          String   @map("district_code")
  geographyUnitId       String?  @map("geography_unit_id")
  acsYear               Int      @map("acs_year")
  pres2024Margin        Decimal? @map("pres_2024_margin") @db.Decimal(6, 4) // D minus R, as a fraction
  partisanLean          Decimal? @map("partisan_lean") @db.Decimal(6, 4)
  population            Int?
  medianHouseholdIncome Int?     @map("median_household_income")
  demographics          Json?
  sourceId              String   @map("source_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  geographyUnit GeographyUnit? @relation(fields: [geographyUnitId], references: [id], onDelete: SetNull)
  source        DataSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([stateCode, districtCode, acsYear])
  @@index([geographyUnitId])
  @@map("district_profiles")
}

// One LLM agent job. Stores enough to trace and reproduce any AI output.
// The trigger_signal_id link to race_signal_events arrives in batch 2.
model AgentRun {
  id            String             @id @default(uuid())
  agent         AgentKind
  model         String
  promptVersion String             @map("prompt_version")
  schemaVersion String             @map("schema_version")
  status        IngestionRunStatus @default(QUEUED)
  inputSha256   String             @map("input_sha256")
  input         Json
  rawOutput     Json?              @map("raw_output")
  error         String?            @db.Text
  inputTokens   Int?               @map("input_tokens")
  outputTokens  Int?               @map("output_tokens")
  startedAt     DateTime?          @map("started_at")
  completedAt   DateTime?          @map("completed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  newsStories NewsStory[]

  @@unique([agent, promptVersion, inputSha256])
  @@index([agent, createdAt])
  @@index([status, createdAt])
  @@map("agent_runs")
}

enum DemographicGeoType {
  NATION
  STATE
  COUNTY
  CONGRESSIONAL_DISTRICT
  COUNTY_DISTRICT_PART
}

// ACS 5-year estimates per Census geography and vintage, keyed by Census GEOID.
// COUNTY_DISTRICT_PART is the piece of a county inside one congressional district.
// Estimates and margins of error are stored as published, keyed by variable
// (e.g. "B03002_003"); null means Census published no value. Percentages,
// combined medians, and combined margins are derived in code.
model AreaDemographics {
  id             String             @id @default(uuid())
  geoType        DemographicGeoType @map("geo_type")
  geoid          String
  name           String
  stateCode      String?            @map("state_code")
  countyFips     String?            @map("county_fips")
  districtCode   String?            @map("district_code")
  // Congress whose district lines the ACS vintage tabulates (119 for ACS 2024).
  congress       Int?
  acsYear        Int                @map("acs_year")
  catalogVersion String             @map("catalog_version")
  estimates      Json
  moes           Json
  sourceUrl      String             @map("source_url")
  sourceId       String             @map("source_id")
  ingestionRunId String             @map("ingestion_run_id")
  fetchedAt      DateTime           @map("fetched_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  source       DataSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Restrict)

  @@unique([geoType, geoid, acsYear])
  @@index([acsYear, stateCode, geoType])
  @@index([ingestionRunId])
  @@map("area_demographics")
}

// FEC Schedule E independent expenditures: spending by outside groups (super
// PACs, parties, 501(c)s) for or against a federal candidate, never coordinated
// with the campaign. One row per OpenFEC Schedule E line, keyed by its sub_id.
// 24- and 48-hour notices are kept alongside regular reports; totals decide
// which to count (see services/outside-spending), so storage stays faithful.
model IndependentExpenditure {
  id                String    @id @default(uuid())
  subId             String    @unique @map("sub_id")
  cycle             Int
  committeeId       String    @map("committee_id")
  committeeName     String    @map("committee_name")
  // FEC candidate ID, not a foreign key: groups can target candidates we do not track.
  candidateId       String?   @map("candidate_id")
  candidateName     String?   @map("candidate_name")
  candidateOffice   String?   @map("candidate_office") // H, S, P
  candidateState    String?   @map("candidate_state")
  candidateDistrict String?   @map("candidate_district") // two digits for House
  supportOppose     String    @map("support_oppose") // S or O
  amount            Decimal   @db.Decimal(15, 2)
  expenditureDate   DateTime? @map("expenditure_date") @db.Date
  disseminationDate DateTime? @map("dissemination_date") @db.Date
  description       String?   @db.Text
  communicationType String    @map("communication_type")
  payeeName         String?   @map("payee_name")
  isNotice          Boolean   @default(false) @map("is_notice") // 24- or 48-hour notice
  isMemo            Boolean   @default(false) @map("is_memo")
  filingForm        String?   @map("filing_form")
  transactionId     String?   @map("transaction_id")
  fileNumber        Int?      @map("file_number")
  pdfUrl            String?   @map("pdf_url")
  fetchedAt         DateTime  @map("fetched_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([cycle, candidateId])
  @@index([cycle, candidateState, candidateOffice, candidateDistrict])
  @@index([cycle, committeeId])
  @@index([cycle, expenditureDate])
  @@map("independent_expenditures")
}

// Progress of the Schedule E sync for one cycle. The backfill walks OpenFEC's
// keyset cursor from newest to oldest across runs; the recent window is
// re-fetched in full on every run.
model ScheduleESyncState {
  cycle              Int       @id
  // Everything dated before this is covered by the backfill; on or after it, by the recent window.
  backfillBefore     DateTime? @map("backfill_before") @db.Date
  backfillCursor     Json?     @map("backfill_cursor")
  backfillStartedAt  DateTime? @map("backfill_started_at")
  backfillComplete   Boolean   @default(false) @map("backfill_complete")
  backfillDoneAt     DateTime? @map("backfill_done_at")
  lastWindowSyncedAt DateTime? @map("last_window_synced_at")
  lastError          String?   @map("last_error") @db.Text
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("schedule_e_sync_state")
}

// News top stories (docs/plans/news-agents.md, "Scope change"). Only the
// published list is stored: each news sync replaces every row, so the table
// never holds more than NEWS_TOP_STORIES_LIMIT rows. Apify's raw articles are
// grouped in memory and never written.

enum NewsTopic {
  CAMPAIGN // Debates, ads, endorsements, rallies
  POLLS
  CONGRESS
  WHITE_HOUSE
  COURTS // Lawsuits, rulings, investigations, ethics
  MONEY // Fundraising and outside spending
  VOTING // Voting rules, access, early voting, administration
  RESULTS
  POLICY
  OTHER
}

enum NewsSelectionMethod {
  AI // Picked by Agent 10 (TOP_STORIES)
  RANKED // Ranked by code: outlets covering the story, decayed by age
}

model NewsStory {
  id             String              @id @default(uuid())
  rank           Int // 1 is the most important
  headline       String // The publisher's own headline
  snippet        String?             @db.Text // Search snippet, capped at 300 characters
  outlet         String
  outletDomain   String              @map("outlet_domain")
  url            String // Canonical publisher URL
  publishedAt    DateTime            @map("published_at")
  topic          NewsTopic
  stateCode      String?             @map("state_code") // Set when the story is about one state
  outletCount    Int                 @map("outlet_count") // Outlets that ran this story in the window
  alsoCoveredBy  Json                @default("[]") @map("also_covered_by") // [{ outlet, url }], at most 4
  selectedBy     NewsSelectionMethod @map("selected_by")
  ingestionRunId String              @map("ingestion_run_id")
  agentRunId     String?             @map("agent_run_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  ingestionRun IngestionRun @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([rank])
  @@index([publishedAt])
  @@index([ingestionRunId])
  @@map("news_stories")
}
