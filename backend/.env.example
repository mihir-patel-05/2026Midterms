# Database
# Local development: Use local PostgreSQL
# Railway: Set this in Railway dashboard (auto-provided when you add PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/midterms2026

# FEC API
FEC_API_KEY=your_fec_api_key_here
FEC_API_BASE_URL=https://api.open.fec.gov/v1

# Chat (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=3001
NODE_ENV=development

# Rate Limiting
FEC_API_MAX_REQUESTS_PER_HOUR=120

# Operational endpoint authentication. Use separate long, random secrets.
SYNC_API_KEY=replace-with-a-long-random-sync-key
RESEARCHER_JWT_SECRET=replace-with-a-long-random-researcher-secret

# Explicit browser origins allowed by CORS in production.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Ideology scoring (GovTrack-based) — see IDEOLOGY_SYNC.md and `npm run sync:ideology`.
# Defaults are fine for most setups; override only to pin a Congress or proxy the
# data hosts. The sync host (govtrack.us) and crosswalk host
# (raw.githubusercontent.com) must be reachable / allowlisted for egress.
IDEOLOGY_CONGRESS=119
IDEOLOGY_GOVTRACK_BASE_URL=https://www.govtrack.us/data/analysis/by-congress
IDEOLOGY_LEGISLATORS_URL=https://raw.githubusercontent.com/unitedstates/congress-legislators/main/legislators-current.yaml
