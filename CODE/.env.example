# API Keys - Template file for environment variables
# Copy this file to .env and fill in your actual values

# Backend API URL
# Development: http://localhost:3001
# Production: https://your-backend-url.railway.app
VITE_API_URL=http://localhost:3001

# Dashboard and mock fixtures are independently gated and default off.
VITE_FEATURE_ELECTION_DASHBOARD=false
VITE_RESULTS_PROVIDER_MOCK_ENABLED=false

# New dark election-monitor frontend (shell, theme, dashboard home page).
# On unless set to "false"; set it to false to roll back to the legacy frontend.
VITE_FEATURE_NEW_FRONTEND=true

# Demographics tab (ACS 5-year estimates for selected counties and districts).
# On unless set to "false". It needs the backend's `npm run sync:acs` to have run.
VITE_FEATURE_DEMOGRAPHICS=true

# Economic indicators strip (FRED) under the chamber-control odds on the monitor.
# On unless set to "false". It stays hidden until the backend's `npm run sync:fred` has run.
VITE_FEATURE_ECONOMY=true

# Market odds map mode: each Senate state or House district coloured by its Kalshi market.
# On unless set to "false". It needs the backend's live Kalshi feed.
VITE_FEATURE_ODDS_MAP=true

# Polls and polling averages (VoteHub) on race pages and the monitor's Polls tab.
# On unless set to "false". It shows a notice until the backend's polls database is connected and synced.
VITE_FEATURE_POLLS=true

# Top political stories of the past 24 hours: the /news page and the monitor's Top stories card.
# Off unless set to "true". Needs NEWS_ENABLED=true on the backend.
VITE_FEATURE_NEWS=false

# Vector basemap style for the election map. Defaults to CARTO Dark Matter.
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Database (if needed)
# VITE_DATABASE_URL=your_database_url_here

# Authentication (if needed)
# VITE_AUTH_SECRET=your_auth_secret_here

# Third-party services (if needed)
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_here
# VITE_STRIPE_PUBLIC_KEY=your_stripe_key_here
# VITE_FIREBASE_API_KEY=your_firebase_key_here

# Other configuration
# VITE_APP_ENV=development
